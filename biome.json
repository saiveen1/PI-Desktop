{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"includes": [
			"apps/desktop/src/features/app/**/*.ts",
			"apps/desktop/src/features/app/**/*.tsx",
			"apps/desktop/src/features/chat/composer/**/*.ts",
			"apps/desktop/src/features/chat/composer/**/*.tsx",
			"apps/desktop/src/features/plugins/**/*.ts",
			"apps/desktop/src/features/plugins/**/*.tsx",
			"apps/desktop/src/features/settings/**/*.ts",
			"apps/desktop/src/features/settings/**/*.tsx",
			"apps/desktop/electron/main/runtime/session-launch.ts",
			"apps/desktop/electron/main/ipc/workspace-ipc.ts",
			"packages/shared/src/types/**/*.ts",
			"scripts/check-architecture.mjs",
			"scripts/e2e/*.mjs",
			"scripts/build-personal-release.mjs",
			"scripts/workspace-version.mjs",
			"scripts/personal-build-source.mjs",
			"scripts/personal-release-notes.mjs",
			"scripts/release.mjs",
			"scripts/check-agent-policy-sync.mjs",
			"apps/desktop/electron-builder.personal.cjs",
			"apps/desktop/test/personal-release.test.mjs",
			"apps/desktop/test/personal-release-history.test.mjs",
			"apps/desktop/test/workspace-version.test.mjs",
			"apps/desktop/test/agent-policy-sync.test.mjs",
			"apps/desktop/test/helpers/personal-release-fixture.mjs",
			"!!worktrees/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	}
}
